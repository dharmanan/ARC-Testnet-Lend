# Environment Variables for ARC Testnet Lending Protocol

# Arc Testnet RPC URL
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Private key for deployment (use with caution)
PRIVATE_KEY=your_private_key_here

# Contract Addresses
LENDING_POOL_ADDRESS=0x9dD7314B876fF9dFFB4F9aC4d4c8540156cf10b9
AMM_ETH_WBTC_ADDRESS=0xF4638B258905C6a2F7Aa71E05aAC887dB697c338
AMM_ETH_ARC_ADDRESS=0x677df5298Fd0a80672b1E6B4a61BEB75534a83A1
AMM_WBTC_ARC_ADDRESS=0x27e14cfEF1a029A32F574263dce67371bce32d24

# Token Addresses
ETH_ADDRESS=0x6dC1d97820974558e1bD555C04a5A19608F9512d
WBTC_ADDRESS=0x27488Db1F8F9529B5820De984262179Ad913798E
ARC_ADDRESS=0x56EFFB3b22DBBE576E4327D196aa5ed51476924e

# Optional: Etherscan API Key for verification
ETHERSCAN_API_KEY=

# Optional: Infura/Alchemy API Key
